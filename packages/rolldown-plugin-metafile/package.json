{
  "name": "rolldown-plugin-metafile",
  "version": "0.1.0",
  "description": "Emit an esbuild-compatible metafile from Rolldown, tsdown, or Vite builds.",
  "keywords": [
    "bundle-analysis",
    "esbuild",
    "metafile",
    "rolldown",
    "tsdown",
    "vite"
  ],
  "homepage": "https://github.com/mark-omarov/why-kept#readme",
  "bugs": "https://github.com/mark-omarov/why-kept/issues",
  "license": "MIT",
  "author": "Mark Omarov <15357910+mark-omarov@users.noreply.github.com>",
  "repository": "github:mark-omarov/why-kept",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "marked": "^15.0.0",
    "rolldown": "^1.2.4",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "rolldown": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
