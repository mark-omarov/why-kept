{
  "name": "rolldown-plugin-metafile",
  "version": "0.1.0",
  "description": "Emit an esbuild-compatible metafile from Rolldown, tsdown, or Vite builds.",
  "keywords": ["rolldown", "tsdown", "vite", "metafile", "esbuild", "bundle-analysis"],
  "homepage": "https://github.com/mark-omarov/why-kept#readme",
  "bugs": "https://github.com/mark-omarov/why-kept/issues",
  "license": "MIT",
  "author": "Mark Omarov <15357910+mark-omarov@users.noreply.github.com>",
  "repository": "github:mark-omarov/why-kept",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "rolldown": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "marked": "^15.0.0",
    "rolldown": "^1.2.4",
    "tsdown": "^0.9.9",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
